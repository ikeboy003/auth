{
  "name": "@ikeboy003/auth",
  "version": "0.2.1",
  "description": "Headless Cognito auth/session primitive: configure-at-import from env (or explicit), framework-agnostic core + optional React binding. Drop-in — wire nothing when the env is set. No brand/routing logic baked in.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "auth",
    "cognito",
    "amplify",
    "session",
    "headless"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "aws-amplify": "^6",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "aws-amplify": "^6.16.3",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikeboy003/ikeboy-npm-packages.git",
    "directory": "packages/auth"
  }
}
